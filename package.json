{
  "name": "@galleon/lit-grid-shell",
  "version": "0.1.0",
  "description": "K8s-native modular shell — CSS Grid + Lit + polyfea",
  "type": "module",
  "exports": {
    ".": { "import": "./dist/galleon-lit-grid-shell.js" },
    "./viewport": { "import": "./dist/galleon-viewport.js" },
    "./inventory": { "import": "./dist/galleon-inventory.js" }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "@polyfea/core": "^1.3.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "happy-dom": "^14.0.0"
  }
}
