{
  "name": "@galleon/lit-grid-shell",
  "version": "0.1.0",
  "description": "K8s-native modular shell — CSS Grid + Lit + polyfea",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/galleon-lit-grid-shell.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polyfea/core": "^1.3.1",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@vitest/ui": "^1.6.0",
    "happy-dom": "^14.12.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  }
}
